    "chart.js": "^4.5.1",
    "papaparse": "^5.7.0",
    "sharp": "^0.35.4",
    "sql.js": "^1.14.2",
    "tabulator-tables": "^6.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.4.11",
    "@types/tabulator-tables": "^6.3.6",
    "typescript": "^6.0.3"
  }
}
