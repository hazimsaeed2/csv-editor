{
  "name": "csv-grid-editor-site",
  "private": true,
  "type": "module",
  "description": "Documentation site for the CSV Editor VS Code extension, published at https://apps.bash-365.com/csv-vscode.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
